# サイト健診の環境変数
#
# 使い方: このファイルを .env.local にコピーして、使いたい機能の値を入れる。
#   cp .env.example .env.local
#
# 診断（/）は、キーが 1 つも無くても動きます。
# キーはすべてサーバー側でのみ読み、ブラウザには渡しません（NEXT_PUBLIC_ の付いたものを除く）。

# ── Anthropic（Claude）────────────────────────────────────────
# 「想定 FAQ の生成」だけに使う。未設定ならその欄を出しません。
# ANTHROPIC_API_KEY=

# FAQ 生成に使うモデル（既定: claude-haiku-4-5）
# FAQ_MODEL=claude-haiku-4-5

# ── FAQ 生成の上限 ───────────────────────────────────────────
# 実費が出るので 1 日の全体上限を置く（既定 500）。0 にすると FAQ 生成を止められる。
# IP ごとの制限（20 回 / 時）はコード側（src/lib/free/ratelimit.ts）。
# FREE_FAQ_DAILY_LIMIT=500

# ── クロール ───────────────────────────────────────────────────
# 「サイト全体」で取得するページ数の上限（既定 300、上限 1000）
# SITE_MAX_PAGES=300

# ── 表示 ───────────────────────────────────────────────────────
# フッターのバージョン表記（省略時は package.json の version）
# NEXT_PUBLIC_APP_VERSION=

# レポート末尾の「次のステップ」に出す連絡先（運営元のもの。両方無ければブロックごと非表示）
# NEXT_PUBLIC_CONTACT_NAME=
# NEXT_PUBLIC_CONTACT_URL=

# ── 開発用 ─────────────────────────────────────────────────────
# localhost や LAN 内のサイトを診断したいときだけ 1 にする（本番では絶対に設定しない）
# ALLOW_PRIVATE_HOSTS=1
